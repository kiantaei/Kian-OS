#!/bin/bash
# Kian OS — the Kian OS installer (no archinstall).
#
# Kian OS ships its OWN installer. It asks exactly TWO questions —
#   1. which mirror region to download packages from ("repo regen")
#   2. the timezone
# — and does everything else automatically: picks the target disk, partitions
# and formats it, installs the full Kian OS desktop from the chosen mirrors,
# installs GRUB, creates the `kian` user and applies the Kian OS branding.
#
# USAGE
#   sudo kian-install              # 2-question guided install
#   sudo kian-install --disk /dev/sdX   # force the target disk (skip detection)
#   sudo kian-install --help
#
# The target disk is chosen automatically: empty unpartitioned disks first
# (the typical VMware/new-VM case), then the largest disk that is NOT the
# boot medium. Before anything is erased there is a 10-second countdown —
# press Ctrl+C to abort, Enter to continue. Nothing is a hidden question.
#
# The advanced full-control installer (Kian's archinstall fork) is still on
# the ISO: run `sudo kianinstall` for menu-driven partitioning choices.

set -uo pipefail

MOUNT=/mnt
LOG=/tmp/kian-install.log

say()  { printf '\033[1;34m[kian-install]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[kian-install]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[kian-install] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; }

for arg in "$@"; do
    case "$arg" in
        -h|--help) usage; exit 0 ;;
        --disk) DISK_ARG_PENDING=1 ;;
        --disk=*) DISK_ARG="${arg#--disk=}" ;;
        *) if [ "${DISK_ARG_PENDING:-0}" = "1" ]; then DISK_ARG="$arg"; DISK_ARG_PENDING=0; else die "unknown argument: $arg (try --help)"; fi ;;
    esac
done

[ "$(id -u)" -eq 0 ] || die "must run as root:  sudo kian-install"
findmnt -n /run/archiso/bootmnt >/dev/null 2>&1 \
    || die "this is the live ISO installer — boot the Kian OS ISO first"

command -v pacstrap >/dev/null || die "pacstrap not found (arch-install-scripts package missing from this ISO)"
command -v parted   >/dev/null || die "parted not found on this ISO"

# Wait for a partition device node to appear. parted writes the table, but the
# kernel/udev can create /dev/sdaN a moment later — formatting a node that does
# not exist yet is what produced "The file /dev/sda1 does not exist".
wait_for_part() {
    local dev="$1" i
    for i in $(seq 1 50); do
        [ -b "$dev" ] && return 0
        sleep 0.2
    done
    return 1
}

# ---------------------------------------------------------------------------
# Question 1 of 2 — mirror region ("repo regen")
# ---------------------------------------------------------------------------
REGIONS=(
    "IR|Iran"
    "AE|United Arab Emirates"
    "TR|Türkiye"
    "DE|Germany"
    "NL|Netherlands"
    "FR|France"
    "GB|United Kingdom"
    "SE|Sweden"
    "PL|Poland"
    "RU|Russia"
    "CN|China"
    "JP|Japan"
    "KR|South Korea"
    "IN|India"
    "SG|Singapore"
    "US|United States"
    "CA|Canada"
    "BR|Brazil"
    "AU|Australia"
)
TZ_OPTIONS=(
    "Asia/Tehran"
    "UTC"
    "Asia/Dubai"
    "Asia/Istanbul"
    "Europe/Berlin"
    "Europe/London"
    "Europe/Paris"
    "Europe/Moscow"
    "Asia/Kolkata"
    "Asia/Shanghai"
    "Asia/Tokyo"
    "Asia/Singapore"
    "America/New_York"
    "America/Chicago"
    "America/Los_Angeles"
)

ask_region() {
    echo
    say "Question 1 of 2 — mirror region: where should packages be downloaded from?"
    echo
    local i=1 r
    for r in "${REGIONS[@]}"; do
        printf '  %2d) %s\n' "$i" "${r#*|}"
        i=$((i + 1))
    done
    printf '  %2d) keep the mirrors bundled on this ISO (global)\n' "$i"; KEEP_IDX=$i
    printf '  %2d) auto-detect (official status API, worldwide)\n' $((i + 1)); AUTO_IDX=$((i + 1))
    local sel
    while :; do
        printf '\nSelect region [1-%d]: ' $((i + 1))
        read -r sel || die "input ended (EOF) — aborting, nothing has been touched"
        case "$sel" in
            ''|*[!0-9]*) ;;
            *) [ "$sel" -ge 1 ] && [ "$sel" -le "$((i + 1))" ] && break ;;
        esac
        echo "  please enter a number between 1 and $((i + 1))"
    done
    if [ "$sel" -eq "$KEEP_IDX" ]; then
        REGION_CODE=""
        say "keeping the bundled mirrorlist"
    elif [ "$sel" -eq "$AUTO_IDX" ]; then
        REGION_CODE="auto"
    else
        REGION_CODE="${REGIONS[$((sel - 1))]%%|*}"
        say "region: ${REGIONS[$((sel - 1))]#*|} ($REGION_CODE)"
    fi
}

regen_mirrorlist() {
    local url="" tmp="/tmp/kian-mirrorlist.$$"
    case "${REGION_CODE:-}" in
        "") return 0 ;;
        auto)
            say "regenerating /etc/pacman.d/mirrorlist (official status API, worldwide) ..."
            url="https://archlinux.org/mirrorlist/?protocol=https&use_mirror_status=on&country=all"
            ;;
        *)
            say "regenerating /etc/pacman.d/mirrorlist for $REGION_CODE ..."
            url="https://archlinux.org/mirrorlist/?country=${REGION_CODE}&protocol=https&use_mirror_status=on"
            ;;
    esac
    # Build the new mirrorlist in a TEMP file. Writing the redirect straight to
    # /etc/pacman.d/mirrorlist truncates it before curl runs, so a failed fetch
    # (curl: (56) Recv failure) left an EMPTY mirrorlist and pacstrap then died
    # with "failed to synchronize all databases (no servers configured)".
    if curl -fsSL --max-time 30 "$url" 2>/dev/null \
        | sed -E 's/^#(Server = https:.*)$/\1/' >"$tmp" \
        && grep -q '^Server = ' "$tmp"; then
        install -m 644 "$tmp" /etc/pacman.d/mirrorlist
        rm -f "$tmp"
        say "mirrorlist regenerated: $(grep -c '^Server = ' /etc/pacman.d/mirrorlist) HTTPS mirror(s)"
        return 0
    fi
    rm -f "$tmp"
    warn "could not fetch mirrors for ${REGION_CODE} — keeping the existing mirrorlist"
    return 1
}

# ---------------------------------------------------------------------------
# Question 2 of 2 — timezone
# ---------------------------------------------------------------------------
ask_timezone() {
    echo
    say "Question 2 of 2 — timezone"
    echo
    local i=1 t
    for t in "${TZ_OPTIONS[@]}"; do
        printf '  %2d) %s\n' "$i" "$t"
        i=$((i + 1))
    done
    printf '  %2d) other — type any zone name (e.g. Asia/Qatar)\n' "$i"
    LAST_TZ_IDX=$i
    local sel
    while :; do
        printf '\nSelect timezone [1-%d]: ' "$i"
        read -r sel || die "input ended (EOF) — aborting, nothing has been touched"
        if [ "$sel" = "$LAST_TZ_IDX" ]; then
            printf 'Timezone (IANA name): '
            read -r TIMEZONE || die "input ended (EOF) — aborting, nothing has been touched"
            break
        fi
        case "$sel" in
            ''|*[!0-9]*) ;;
            *) [ "$sel" -ge 1 ] && [ "$sel" -le "$LAST_TZ_IDX" ] && { TIMEZONE="${TZ_OPTIONS[$((sel - 1))]}"; break; } ;;
        esac
        echo "  please enter a number between 1 and $LAST_TZ_IDX"
    done
    [ -f "/usr/share/zoneinfo/${TIMEZONE}" ] || die "unknown timezone '${TIMEZONE}' (see: ls /usr/share/zoneinfo/)"
    say "timezone: ${TIMEZONE}"
}

# ---------------------------------------------------------------------------
# Target disk detection (no question — automatic, with an erase countdown)
# ---------------------------------------------------------------------------
boot_medium_disk() {   # prints the DISK the ISO booted from (empty if optical)
    local src parent
    src="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null)" || return 0
    case "$src" in
        /dev/sr*|/dev/nvme*r*) echo "" ;;   # optical / nvme namespace cdrom — not a real disk
        *)
            parent="$(lsblk -srno PKNAME "$src" 2>/dev/null | head -n1)"
            [ -n "$parent" ] && echo "/dev/$parent"
            ;;
    esac
}

list_candidate_disks() {
    local bootdisk
    bootdisk="$(boot_medium_disk)"
    lsblk -rno PATH,TYPE,SIZE,MODEL 2>/dev/null | awk '$2 == "disk" && $3 != "0"' | while read -r path _type size model; do
        [ "$path" = "$bootdisk" ] && continue   # never erase the boot medium
        echo "$path|$size|$model"
    done
}

disk_is_fresh() {   # 1 = no partitions, no leftover signatures (a brand-new vmdk)
    local disk="$1"
    [ "$(lsblk -rno TYPE "${disk}" | grep -vc '^disk$')" -eq 0 ] || return 1
    wipefs -q "$disk" >/dev/null 2>&1 && [ -z "$(wipefs -q "$disk" 2>/dev/null)" ] && return 0 || return 1
}

pick_target_disk() {
    local fresh="" fallback="" entry path size model sz_mb best=0
    while IFS='|' read -r path size model; do
        [ -n "$path" ] || continue
        sz_mb="$(numfmt --from=iec "${size:-0}" 2>/dev/null || echo 0)"
        [ "$sz_mb" -ge 10240 ] || continue          # a Kian OS install needs >= 10 GiB
        if disk_is_fresh "$path"; then
            if [ "$sz_mb" -gt "$best" ]; then best="$sz_mb"; fresh="$path|$size|$model"; fi
        elif [ -z "$fallback" ]; then
            fallback="$path|$size|$model"           # first (largest-order) non-fresh disk
        fi
    done < <(list_candidate_disks)
    if [ -n "$fresh" ]; then
        echo "$fresh"
    else
        echo "$fallback"
    fi
}

# ---------------------------------------------------------------------------
ask_region
ask_timezone

echo
say "target disk (automatic — the installer asks no disk question):"
list_candidate_disks | while IFS='|' read -r path size model; do
    printf '    %s  %6s  %s\n' "$path" "$size" "${model:-}"
done

if [ -n "${DISK_ARG:-}" ]; then
    DISK="$DISK_ARG"
    [ -b "$DISK" ] || die "--disk $DISK_ARG is not a block device"
    DISK_FRESH=""
else
    picked="$(pick_target_disk)"
    [ -n "$picked" ] || die "no usable target disk found (>= 10 GiB, not the boot medium). Attach a disk, or pass one explicitly: sudo kian-install --disk /dev/sdX"
    DISK="${picked%%|*}"
    picked="${picked#*|}"
    DISK_SIZE="${picked%%|*}"
    DISK_MODEL="${picked#*|}"
    disk_is_fresh "$DISK" && DISK_FRESH=1 || DISK_FRESH=""
fi

say "selected target disk: $DISK ${DISK_SIZE:+(${DISK_SIZE})} ${DISK_MODEL:+— ${DISK_MODEL}}"
[ -n "${DISK_FRESH:-}" ] && say "the disk is completely empty — nothing can be lost"

echo
echo "==================================================================="
echo "  EVERYTHING ON $DISK WILL BE ERASED AND REPLACED BY KIAN OS."
echo "  Region: ${REGION_CODE:-bundled mirrors}   Timezone: ${TIMEZONE}"
echo "==================================================================="
printf '\nContinuing in 10 seconds — press Ctrl+C to abort NOW, Enter to continue ... '
read -t 10 -r _ || true
echo

# ---------------------------------------------------------------------------
# Partition + format
# ---------------------------------------------------------------------------
# Wipe signatures BEFORE partitioning. Running wipefs after parted deletes the
# fresh partition table — that is exactly what broke the install in 0.4.0
# (/dev/sda1 vanished, mkfs.ext4 failed), so the order here matters.
# Release anything the live session may have auto-mounted from the target
# (Thunar/gvfs mount it on click) and any swap area on it — otherwise
# wipefs/parted fail with "device or resource busy".
while read -r part; do
    [ -n "$part" ] || continue
    swapoff "$part" 2>/dev/null || true
    umount "$part" 2>/dev/null || true
done < <(lsblk -rno PATH "$DISK" 2>/dev/null | tail -n +2)
umount -R "$MOUNT" 2>/dev/null || true
say "clearing old signatures on $DISK ..."
wipefs -a "$DISK" >/dev/null 2>&1 || warn "wipefs reported errors on $DISK (continuing)"
sync

if [ -d /sys/firmware/efi ]; then
    BOOT_MODE="uefi"
    say "UEFI system detected — GPT: 1 GiB ESP + ext4 root"
    parted -s "$DISK" mklabel gpt \
        mkpart ESP fat32 1MiB 1025MiB \
        set 1 esp on \
        mkpart root ext4 1025MiB 100% || die "partitioning failed (is $DISK in use? detach it and retry)"
    case "$DISK" in
        /dev/nvme*|/dev/mmcblk*) PART1="${DISK}p1"; PART2="${DISK}p2" ;;
        *) PART1="${DISK}1"; PART2="${DISK}2" ;;
    esac
else
    BOOT_MODE="bios"
    say "BIOS system — MBR: ext4 root (GRUB in the MBR)"
    parted -s "$DISK" mklabel msdos mkpart primary ext4 1MiB 100% set 1 boot on \
        || die "partitioning failed (is $DISK in use? detach it and retry)"
    case "$DISK" in
        /dev/nvme*|/dev/mmcblk*) PART1="${DISK}p1" ;;
        *) PART1="${DISK}1" ;;
    esac
    PART2=""
fi

# Re-read the partition table and wait for the device nodes before formatting.
partprobe "$DISK" 2>/dev/null || true
udevadm settle --timeout=10 2>/dev/null || true
wait_for_part "$PART1" || die "kernel did not create $PART1 after partitioning — run 'partprobe $DISK' and retry"
if [ -n "$PART2" ]; then
    wait_for_part "$PART2" || die "kernel did not create $PART2 after partitioning — run 'partprobe $DISK' and retry"
fi

if [ -n "$PART2" ]; then
    mkfs.vfat -F32 -n KIAN_EFI "$PART1" || die "mkfs.vfat failed on $PART1"
    mkfs.ext4 -F -L kianos "$PART2" || die "mkfs.ext4 failed on $PART2"
else
    mkfs.ext4 -F -L kianos "$PART1" || die "mkfs.ext4 failed on $PART1"
fi

umount -R "$MOUNT" 2>/dev/null || true
if [ -n "$PART2" ]; then
    mount "$PART2" "$MOUNT" || die "could not mount the new root ($PART2)"
else
    mount "$PART1" "$MOUNT" || die "could not mount the new root ($PART1)"
fi
if [ -n "$PART2" ]; then
    mkdir -p "$MOUNT/efi"
    mount "$PART1" "$MOUNT/efi" || die "could not mount the ESP"
fi

# ---------------------------------------------------------------------------
# Regenerate mirrors + sync databases, then install the full Kian OS desktop
# ---------------------------------------------------------------------------
regen_mirrorlist || warn "could not fetch mirrors for the chosen region — keeping the bundled mirrorlist"
# A mirrorlist without Server lines makes pacstrap fail with the misleading
# "no servers configured for repository". That happens when the status API is
# blocked (e.g. curl: (56)) and the image's own mirrorlist is empty — write a
# small known-good fallback instead of failing the whole install.
if ! grep -q '^Server = ' /etc/pacman.d/mirrorlist 2>/dev/null; then
    warn "no package servers configured — writing the built-in fallback mirrors"
    cat >/etc/pacman.d/mirrorlist <<'FALLBACK'
# Kian OS fallback mirrors (used when the mirror status API is unreachable)
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.leaseweb.net/archlinux/$repo/os/$arch
FALLBACK
fi
# --- rate-limit friendly package downloads (user request) ---
# Packages download ONE at a time with a 10-second gap AFTER every package
# (override: KIAN_DOWNLOAD_THROTTLE=seconds, 0 disables) so rate-limited
# mirrors do not drop the connection. ONLY the download phase is throttled —
# pacman extracts and installs at full speed. pacstrap uses the live
# session's /etc/pacman.conf and /etc/pacman.d/mirrorlist, so editing the
# live config is what actually controls the downloads.
sed -i -E 's/^#?[[:space:]]*ParallelDownloads.*/ParallelDownloads = 1/' /etc/pacman.conf
if grep -q '^XferCommand' /etc/pacman.conf; then
    sed -i 's|^XferCommand.*|XferCommand = /usr/local/bin/kian-throttled-fetch %o %u|' /etc/pacman.conf
else
    sed -i '/^\[options\]/a XferCommand = /usr/local/bin/kian-throttled-fetch %o %u' /etc/pacman.conf
fi
THROTTLE="${KIAN_DOWNLOAD_THROTTLE:-10}"
say "downloads throttled: one package at a time + ${THROTTLE}s gap after each package (KIAN_DOWNLOAD_THROTTLE to change, 0 to disable — installing is NOT throttled)"

say "syncing package databases ..."
if ! pacman -Sy --noconfirm >/tmp/kian-pacman-sync.log 2>&1; then
    tail -5 /tmp/kian-pacman-sync.log >&2 || true
    die "could not sync the package databases — the mirrors are unreachable. Check the network (VMware/QEMU NAT is automatic), rerun and pick another region, or use: sudo kianinstall"
fi
ping -c1 -W5 archlinux.org >/dev/null 2>&1 || die "no network — the installer downloads packages from the mirrors you chose. Connect (VMware/QEMU NAT is automatic) and run: sudo kian-install"

PKGS=(
    base base-devel linux linux-firmware intel-ucode amd-ucode mkinitcpio
    sudo networkmanager network-manager-applet grub efibootmgr dosfstools e2fsprogs
    xorg-server mesa xorg-xrandr xf86-input-libinput xf86-input-vmmouse xf86-video-vesa
    lightdm lightdm-gtk-greeter exo garcon thunar thunar-volman tumbler gvfs
    xfce4-appfinder xfce4-panel xfce4-power-manager xfce4-session xfce4-settings
    xfce4-terminal xfconf xfdesktop xfwm4 xfce4-whiskermenu-plugin xfce4-taskmanager
    xdg-user-dirs xdg-utils polkit-gnome materia-gtk-theme papirus-icon-theme
    ttf-liberation ttf-dejavu noto-fonts
    chromium mousepad galculator
    git python nano bash-completion htop tree man-db fastfetch
    open-vm-tools qemu-guest-agent
)
# The os-release identity hook (the host's /etc/pacman.d/hooks is picked up
# by the pacstrap target) fires during the transaction below. Give it its
# source file up front so it succeeds quietly instead of printing a harmless
# "cannot stat /usr/share/kian/os-release" warning (seen on real hardware).
mkdir -p "$MOUNT/usr/share/kian"
cp /usr/share/kian/os-release "$MOUNT/usr/share/kian/os-release" 2>/dev/null || true

say "installing Kian OS to $DISK (${#PKGS[@]} packages — this downloads a few GB, choose the biggest number for your region next time for speed)"
if ! pacstrap -K "$MOUNT" "${PKGS[@]}" 2>&1 | tee "$LOG"; then
    die "package installation failed — see $LOG (mirror region choice affects speed; try a closer region)"
fi

say "writing /etc/fstab (from the mounted target) ..."
genfstab -U "$MOUNT" > "$MOUNT/etc/fstab" || die "genfstab failed"
# genfstab -U writes entry lines that START with "UUID=" (plus '#' comment
# lines) — no line ever starts with a slash, so the old check (which grepped
# for a leading slash) matched nothing and killed EVERY completed install
# with "fstab came out empty" (seen on real hardware). The root entry is the
# line whose SECOND field is exactly "/":
awk '$2 == "/" {found=1} END {exit !found}' "$MOUNT/etc/fstab" \
    || die "fstab came out empty — no root entry for the target ($MOUNT)"
say "/etc/fstab written: $(grep -vc '^#' "$MOUNT/etc/fstab") entry line(s), root present"

# ---------------------------------------------------------------------------
# Configure the installed system (timezone, locale, user, bootloader)
# ---------------------------------------------------------------------------
mkdir -p "$MOUNT/etc/sudoers.d"
cp /etc/sudoers.d/kian-wheel "$MOUNT/etc/sudoers.d/kian-wheel" && chmod 440 "$MOUNT/etc/sudoers.d/kian-wheel"
cp /etc/pacman.d/mirrorlist "$MOUNT/etc/pacman.d/mirrorlist" 2>/dev/null || true

say "configuring timezone (${TIMEZONE}), locale, user and bootloader ..."
export KIAN_TZ="$TIMEZONE" KIAN_BOOT_MODE="$BOOT_MODE" KIAN_DISK="$DISK"
if ! arch-chroot "$MOUNT" /bin/bash <<'CHROOT'
set -euo pipefail
ln -sf "/usr/share/zoneinfo/${KIAN_TZ}" /etc/localtime
hwclock --systohc || true
echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
locale-gen >/dev/null
echo "LANG=en_US.UTF-8" > /etc/locale.conf
echo "kian-os" > /etc/hostname
printf '127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\tkian-os.localdomain\tkian-os\n' > /etc/hosts
useradd -m -u 1000 -c "Kian OS user" -s /bin/bash kian
echo 'kian:kian' | chpasswd
usermod -aG wheel,users,audio,video,storage,optical,input kian
usermod -L root
mkinitcpio -P >/dev/null
if [ "${KIAN_BOOT_MODE}" = "uefi" ]; then
    grub-install --target=x86_64-efi --efi-directory=/efi --bootloader-id=KIAN_OS --recheck
else
    grub-install --target=i386-pc "${KIAN_DISK}" --recheck
fi
sed -i 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR="Kian OS"|' /etc/default/grub
grub-mkconfig -o /boot/grub/grub.cfg >/dev/null
systemctl enable NetworkManager.service lightdm.service vmtoolsd.service >/dev/null 2>&1
CHROOT
then
    die "system configuration failed — see $LOG"
fi
say "system configured: user kian (password kian), GRUB, NetworkManager + LightDM enabled"

# ---------------------------------------------------------------------------
# Kian OS identity: wallpaper, xenox, launchers, panel defaults
# ---------------------------------------------------------------------------
if [ -x /usr/local/bin/kian-apply ]; then
    say "applying Kian OS branding ..."
    KIAN_LIVE_ROOT=/ /usr/local/bin/kian-apply -y "$MOUNT" || warn "branding had errors — the install still works; run sudo kian-apply $MOUNT later"
fi

sync
umount -R "$MOUNT" 2>/dev/null || umount -l -R "$MOUNT" 2>/dev/null || true

cat <<EOF

===================================================================
  Kian OS is installed on $DISK (timezone: ${TIMEZONE}).
===================================================================

  * user: kian   password: kian   (change it after first login: passwd)
  * boots straight into the Kian OS desktop (LightDM + XFCE)
  * in your VM: power off, DETACH the ISO from the CD drive, then boot

  Reboot now with:  sudo reboot
EOF
exit 0
