#!/bin/bash
# Kian OS — live session user setup.
# Creates the real `kian` user account (uid 1000, bash, wheel for sudo),
# locks direct root login (never run as root — use sudo), seeds the home
# directory from /etc/skel and ensures the standard XDG folders exist.
set -euo pipefail

# --- Real user account ------------------------------------------------------
if ! getent passwd kian >/dev/null; then
    useradd -m -u 1000 -c "Kian OS user" -s /bin/bash kian
fi

# Groups: wheel => sudo access; the rest are standard desktop groups.
# 'autologin' is REQUIRED by lightdm >= 1.33 for passwordless autologin
# (see /etc/pam.d/lightdm-autologin: pam_succeed_if "user ingroup autologin");
# the group is not created by the lightdm package, so create it here.
groupadd -f autologin
usermod -aG wheel,users,audio,video,storage,optical,input,autologin kian 2>/dev/null || true

# Live medium default password (kian / kian). Change it with `passwd`
# after installing Kian OS to disk.
# In a PERSISTENT live session (KIANPERSIST, see kian-persist) /etc survives
# reboots — resetting the password here would clobber a changed one every
# boot, so it is applied only on the first session (marker file in home).
if ! getent passwd kian >/dev/null || [ ! -f "${HOME_DIR:-/home/kian}/.kian-live-initialized" ]; then
    echo 'kian:kian' | chpasswd
fi

# Root must not be logged into directly; privilege escalation is sudo.
usermod -L root 2>/dev/null || true

# --- Home directory ---------------------------------------------------------
HOME_DIR=/home/kian
if [ ! -d "${HOME_DIR}" ]; then
    mkdir -p "${HOME_DIR}"
    cp -a /etc/skel/. "${HOME_DIR}/"
    # first session done — the default password was just applied (see above)
    touch "${HOME_DIR}/.kian-live-initialized"
fi
# Make sure every file in the home is owned by kian (never root).
chown -R kian:kian "${HOME_DIR}"

for d in Desktop Documents Downloads Music Pictures Videos; do
    if [ ! -d "${HOME_DIR}/${d}" ]; then
        install -d -m 755 -o kian -g kian "${HOME_DIR}/${d}"
    fi
done

# Desktop launchers must be executable, otherwise xfdesktop/Thunar refuse to
# run them and show "Untrusted application launcher" on first click. The
# checksum that XFCE >= 4.18 also requires is per-user GVFS metadata and is
# applied inside the session by /usr/local/bin/kian-trust-desktop (autostart).
chmod 755 "${HOME_DIR}"/Desktop/*.desktop 2>/dev/null || true
chown kian:kian "${HOME_DIR}"/Desktop/*.desktop 2>/dev/null || true

exit 0
