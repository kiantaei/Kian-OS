#!/bin/bash
# Kian OS — throttled package downloader, used as pacman's XferCommand.
#
# WHY: rate-limited mirrors (common with Iranian ISPs) reject rapid
# back-to-back package downloads. kian-install makes downloads serial
# (ParallelDownloads = 1) and this wrapper waits KIAN_DOWNLOAD_THROTTLE
# seconds (default 10) after every successful download before pacman starts
# the next one. EXTRACTION IS NOT THROTTLED — pacman unpacks the packages at
# full speed; only the download phase has gaps between packages.
#
# USAGE (kian-install writes this into the live session's /etc/pacman.conf):
#   XferCommand = /usr/local/bin/kian-throttled-fetch %o %u
#
# %o = output file pacman expects, %u = the URL. A non-zero exit makes
# pacman try the next mirror. Resume (-C -) plus retries keep a slow mirror
# from aborting a multi-GB download; the throttle can be disabled with
# KIAN_DOWNLOAD_THROTTLE=0 and tuned to any number of seconds.

set -u
OUT="$1"
URL="$2"
THROTTLE="${KIAN_DOWNLOAD_THROTTLE:-10}"

RC=1
for attempt in 1 2 3; do
    if curl -L -C - -f --retry 2 -sS -o "$OUT" "$URL"; then
        RC=0
        break
    fi
    RC=$?
    echo "kian-throttled-fetch: attempt $attempt for $URL failed (rc=$RC) — retrying" >&2
    sleep 3
done

if [ "$RC" -eq 0 ] && [ "${THROTTLE:-10}" -gt 0 ] 2>/dev/null; then
    # the requested gap AFTER each package download (not during install)
    sleep "$THROTTLE"
fi
exit "$RC"
