#!/bin/bash
# Kian OS — run Windows .exe programs with Proton.
#
#   proton-exe "test.exe"                 # run a Windows program
#   proton-exe --proton ~/GE-Proton10-4 app.exe   # use a specific Proton build
#   proton-exe --prefix ~/.wine game.exe          # use a specific prefix
#
# HOW IT WORKS (honest)
#   Proton is Valve's Wine build. Outside Steam it needs a runtime shim; that
#   is what umu-launcher (multilib package) provides: `umu-run` starts the
#   program inside the same Steam Linux Runtime container Steam uses, without
#   a Steam account or the Steam client.
#
#   Proton itself is not in the Arch repositories — Valve ships it through
#   Steam. This script therefore uses, in this order:
#     1. $PROTON_PATH / --proton, if you point it at a Proton directory,
#     2. Valve's "Proton - Experimental" from an installed Steam (Library →
#        Tools → Proton Experimental),
#     3. UMU-Proton — the Proton-Experimental-based build that umu-launcher
#        downloads on first use (needs internet once; stored under
#        ~/.local/share/Steam/compatibilitytools.d/).
#
#   If umu-launcher is not installed but a Proton directory exists, the script
#   falls back to Proton's own `proton run` with STEAM_COMPAT_* variables.
#
#   Double-clicking a .exe in the file manager does the same thing: the
#   "Open with Proton" desktop entry is the default handler for Windows
#   executables (/etc/xdg/mimeapps.list → proton-exe.desktop).

set -uo pipefail

PROTON_REQ="${PROTON_PATH:-}"
PREFIX="${WINEPREFIX:-}"
EXE=""
ARGS=()

say()  { printf '\033[1;34m[proton-exe]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[proton-exe]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mproton-exe:\033[0m %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --proton)   [ "$#" -ge 2 ] || die "--proton needs a path"; PROTON_REQ="$2"; shift 2 ;;
        --proton=*) PROTON_REQ="${1#*=}"; shift ;;
        --prefix)   [ "$#" -ge 2 ] || die "--prefix needs a path"; PREFIX="$2"; shift 2 ;;
        --prefix=*) PREFIX="${1#*=}"; shift ;;
        --) shift; break ;;
        -*) die "unknown option: $1 (try --help)" ;;
        *)  EXE="$1"; shift; break ;;
    esac
done
ARGS=("$@")

[ -n "$EXE" ] || { usage; exit 2; }
[ -f "$EXE" ] || die "no such file: $EXE"
EXE="$(readlink -f "$EXE")"

# --- find a Proton build ----------------------------------------------------
find_proton() {
    local c
    for c in \
        "$HOME/.steam/steam/steamapps/common/Proton - Experimental" \
        "$HOME/.steam/root/steamapps/common/Proton - Experimental" \
        "$HOME/.local/share/Steam/steamapps/common/Proton - Experimental" \
        "/usr/share/steam/steamapps/common/Proton - Experimental" \
        /opt/Proton-Experimental; do
        [ -x "$c/proton" ] && { printf '%s\n' "$c"; return 0; }
    done
    # Any Proton installed as a compatibility tool (GE-Proton, UMU-Proton, …).
    for c in "$HOME"/.local/share/Steam/compatibilitytools.d/*; do
        [ -x "$c/proton" ] || continue
        case "${c##*/}" in
            *Proton*) printf '%s\n' "$c"; return 0 ;;
        esac
    done
    return 1
}

PROTON_DIR=""
PROTON_TOKEN=""
if [ -n "$PROTON_REQ" ]; then
    case "$PROTON_REQ" in
        UMU-Proton|UMU-Latest|GE-Proton|GE-Latest)
            # Build codenames umu-launcher downloads itself.
            PROTON_TOKEN="$PROTON_REQ"
            ;;
        *)
            if [ -d "$PROTON_REQ" ] && [ -x "$PROTON_REQ/proton" ]; then
                PROTON_DIR="$(readlink -f "$PROTON_REQ")"
            elif [ -d "$HOME/.local/share/Steam/compatibilitytools.d/$PROTON_REQ" ]; then
                PROTON_DIR="$HOME/.local/share/Steam/compatibilitytools.d/$PROTON_REQ"
            else
                die "'$PROTON_REQ' is neither a Proton directory (needs an executable 'proton') nor a codename (UMU-Proton, UMU-Latest, GE-Proton, GE-Latest)"
            fi
            ;;
    esac
else
    PROTON_DIR="$(find_proton || true)"
fi

# Prefix: one per Proton build, so switching builds never corrupts a prefix.
if [ -z "$PREFIX" ]; then
    label="default"
    [ -n "$PROTON_DIR" ] && label="$(basename "$PROTON_DIR" | tr ' /' '__')"
    PREFIX="$HOME/.local/share/kian-proton/$label"
fi
export WINEPREFIX="$PREFIX"
mkdir -p "$PREFIX" || die "cannot create prefix directory $PREFIX"

if [ -n "$PROTON_DIR" ]; then
    say "Proton: $PROTON_DIR"
elif [ -n "$PROTON_TOKEN" ]; then
    say "Proton: $PROTON_TOKEN (downloaded by umu-launcher on first use)"
else
    say "no local Proton build found — umu will use UMU-Proton (Proton Experimental based)"
    say "the first run downloads UMU-Proton + the Steam Linux Runtime (needs internet)"
fi
say "prefix: $WINEPREFIX"

# Windows programs often expect to be started from their own directory.
cd "$(dirname "$EXE")" 2>/dev/null || cd "$HOME" || true

# --- run it ----------------------------------------------------------------
if command -v umu-run >/dev/null 2>&1; then
    export GAMEID="${GAMEID:-0}"          # 0 = no game-specific protonfixes
    export PROTON_VERB="${PROTON_VERB:-waitforexitandrun}"
    if [ -n "$PROTON_DIR" ]; then
        export PROTONPATH="$PROTON_DIR"
    elif [ -n "$PROTON_TOKEN" ]; then
        export PROTONPATH="$PROTON_TOKEN"
    fi
    # umu downloads Proton/runtime on first use and prints its progress.
    umu-run "$EXE" "${ARGS[@]}"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        cat >&2 <<'EOF'

proton-exe: Proton could not start.

  * The first run downloads Proton and the Steam Linux Runtime, so it needs
    internet (GitHub for the Proton archive, Steam CDN for the runtime).
    Behind a proxy, export it first:  export HTTPS_PROXY=http://host:port

  * If the download is blocked, use a Proton build you already have:
        proton-exe --proton /path/to/Proton-Experimental app.exe

  * Or ask umu for a specific build:
        proton-exe --proton GE-Proton app.exe
        proton-exe --proton UMU-Proton app.exe

  * Or install Valve's "Proton Experimental" through Steam and re-run
    (proton-exe picks it up automatically).
EOF
    fi
    exit "$rc"
fi

if [ -n "$PROTON_DIR" ]; then
    warn "umu-launcher is not installed — falling back to Proton's own runner"
    warn "for the Steam runtime container install it:  sudo pacman -S umu-launcher"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$HOME/.local/share/Steam}"
    export STEAM_COMPAT_DATA_PATH="$WINEPREFIX"
    exec "$PROTON_DIR/proton" run "$EXE" "${ARGS[@]}"
fi

cat >&2 <<'EOF'
proton-exe: no way to run Windows programs yet.

Install one of these, then run the command again:

  1) umu-launcher (recommended, no Steam account needed):
         sudo pacman -S umu-launcher
     first run downloads UMU-Proton (Proton Experimental based) + the
     Steam Linux Runtime into ~/.local/share/Steam/

  2) Valve's Proton Experimental through Steam:
         sudo pacman -S steam
     Library → Tools → install "Proton Experimental", then re-run this command.

  Already have a Proton build somewhere? Point the command at it:
         proton-exe --proton /path/to/Proton-Experimental app.exe
EOF
exit 1
