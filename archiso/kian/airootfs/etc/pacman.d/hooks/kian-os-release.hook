# Kian OS identity: replace Arch's os-release with the Kian OS one.
#
# WHY A HOOK: mkarchiso copies the profile's airootfs overlay into the new
# root BEFORE pacstrap runs. Overlaying /usr/lib/os-release directly makes
# pacstrap abort ("filesystem: usr/lib/os-release exists in filesystem"),
# because that path is owned by the `filesystem` package and is not a pacman
# backup file (unlike /etc/passwd). This hook applies the Kian identity
# right after the `filesystem` package is installed, during the same
# transaction — the standard archiso pattern (see releng's
# uncomment-mirrors.hook). mkarchiso then appends IMAGE_ID/IMAGE_VERSION
# through the /etc/os-release symlink.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Installing Kian OS identity into /usr/lib/os-release...
When = PostTransaction
Depends = coreutils
Exec = /usr/bin/install -m 0644 /usr/share/kian/os-release /usr/lib/os-release
