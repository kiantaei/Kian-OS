# Kian OS identity: replace Arch's os-release with the Kian OS one.
#
# WHY A HOOK: overlaying /usr/lib/os-release directly makes pacstrap abort
# ("filesystem: usr/lib/os-release exists in filesystem"), because that path
# is owned by the `filesystem` package and is not a pacman backup file (unlike
# /etc/passwd). This hook applies the Kian identity right after the
# `filesystem` package is installed, during the same transaction — the
# standard archiso pattern (see releng's uncomment-mirrors.hook).
# mkarchiso then appends IMAGE_ID/IMAGE_VERSION through the /etc/os-release
# symlink.
#
# WHERE THE SOURCE COMES FROM: at ISO BUILD time mkarchiso overlays the
# profile airootfs (which contains /usr/share/kian/os-release) BEFORE
# pacstrap runs, so the hook finds its source inside the build target. When
# kian-install runs pacstrap on a real install, the host's hook is picked up
# by the target too — kian-install therefore pre-seeds
# $MOUNT/usr/share/kian/os-release before pacstrap so the hook succeeds
# quietly there as well.
#
# IMPORTANT: Exec MUST stay this single plain command. libalpm exec's the
# Exec string DIRECTLY (no shell), so shell syntax here (`[ ... ] && ...`)
# would break hook execution — run 43484412717 shipped an ISO whose live
# identity was plain Arch because of exactly that. A missing source can only
# produce a harmless "cannot stat" warning; the identity is applied AFTERWARD
# by kian-apply with the live root's source, so no guard is needed here.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Installing Kian OS identity into /usr/lib/os-release...
When = PostTransaction
Depends = coreutils
Exec = /usr/bin/install -m 0644 /usr/share/kian/os-release /usr/lib/os-release
