<?xml version="1.0" encoding="UTF-8"?>

<!--
  Kian OS panel — the "taskbar".
  Bottom, 44px, Kian navy acrylic (#1A2B4A at ~92%), with:
    plugin-1  Whisker start menu (searchable, Kian logo button)
    plugin-2  Window buttons (the real taskbar: click = focus/minimize)
    plugin-3  separator (expanding)
    plugin-4  systray (network manager applet etc.)
    plugin-5  clock (click opens the calendar flyout)
-->

<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;o=0"/>
      <property name="length" type="double" value="100.0"/>
      <property name="size" type="uint" value="44"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="background-rgba" type="array">
        <property name="1" type="double" value="0.101960784313725"/>
        <property name="2" type="double" value="0.168627450980392"/>
        <property name="3" type="double" value="0.290196078431373"/>
        <property name="4" type="double" value="0.920000000000000"/>
      </property>
      <property name="plugin-ids" type="array">
        <property name="1" type="int" value="1"/>
        <property name="2" type="int" value="2"/>
        <property name="3" type="int" value="3"/>
        <property name="4" type="int" value="4"/>
        <property name="5" type="int" value="5"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="kian-os-logo"/>
      <property name="button-title" type="string" value="Start"/>
      <property name="button-single-click" type="bool" value="true"/>
    </property>
    <property name="plugin-2" type="string" value="tasklist">
      <property name="show-labels" type="bool" value="true"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="show-tooltips" type="bool" value="true"/>
      <property name="grouping" type="uint" value="0"/>
      <property name="middle-click" type="uint" value="2"/>
    </property>
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-4" type="string" value="systray">
      <property name="show-frame" type="bool" value="false"/>
      <property name="size-max" type="uint" value="22"/>
    </property>
    <property name="plugin-5" type="string" value="clock">
      <property name="digital-format" type="string" value="%a %d %b  %H:%M"/>
      <property name="tooltip-format" type="string" value="%A %d %B %Y"/>
    </property>
  </property>
</channel>
