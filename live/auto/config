#!/bin/sh

# Kian OS 1.0 "Horizon" — live-build configuration.
# Ubuntu 24.04 (noble) base, XFCE desktop, live-boot + live-config,
# Calamares installer, real persistence via a KIANPERSIST store.
#
# Every option here was verified against live-build 3.0~a57-1ubuntu49
# (noble) and the live-boot/live-config 20230131/11.0.4 sources.

set -e

lb config noauto \
    --mode ubuntu \
    --distribution noble \
    --architectures amd64 \
    --archive-areas "main restricted universe multiverse" \
    --bootstrap-flavour minbase \
    --initramfs live-boot \
    --linux-flavours generic \
    --linux-packages linux-image \
    --binary-images iso-hybrid \
    --chroot-filesystem squashfs \
    --binary-filesystem ext4 \
    --bootappend-live "boot=live components persistence persistence-label=KIANPERSIST overlay-size=4G username=kian user-fullname=Kian locales=en_US.UTF-8 timezone=Asia/Tehran keyboard-layouts=us console=ttyS0,115200n8 console=tty0" \
    --bootappend-install "console=ttyS0,115200n8 console=tty0" \
    --iso-volume "KIAN_OS_100" \
    --iso-publisher "Kian OS <https://github.com/kiantaei/Kian-OS>" \
    --iso-application "Kian OS 1.0 Live/Installer Medium (Ubuntu 24.04 base)" \
    --iso-preparer "Kian OS live-build" \
    --memtest none \
    --win false \
    --source false \
    --apt-recommends false \
    --apt-indices false \
    --firmware-binary true \
    --firmware-chroot true \
    --security true \
    --mirror-bootstrap "http://archive.ubuntu.com/ubuntu" \
    --mirror-chroot "http://archive.ubuntu.com/ubuntu" \
    --mirror-binary "http://archive.ubuntu.com/ubuntu" \
    --mirror-binary-security "http://security.ubuntu.com/ubuntu" \
    --parent-mirror-bootstrap "http://archive.ubuntu.com/ubuntu" \
    --parent-mirror-chroot "http://archive.ubuntu.com/ubuntu" \
    --parent-mirror-binary "http://archive.ubuntu.com/ubuntu" \
    --parent-mirror-binary-security "http://security.ubuntu.com/ubuntu" \
    "${@}"
