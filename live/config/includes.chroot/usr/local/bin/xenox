#!/bin/bash
# Kian OS — xenox: the Kian Browser launcher (Falkon engine, Kian start page).
#
# Falkon is a real .deb on Ubuntu noble (chromium/firefox are snap shims and
# cannot be preinstalled in a live-build chroot). xenox opens the Kian start
# page first, then hands any arguments to the browser, exactly like the old
# Chromium-based launcher did.

START_PAGE="file:///usr/share/kian/xenox/start.html"

exec falkon "$START_PAGE" "$@"
