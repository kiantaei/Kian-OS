#!/bin/bash
# Kian OS — real persistence for the live session (Ubuntu live-boot).
#
# A normal live session keeps every change in RAM (a tmpfs overlay thrown
# away at shutdown): files you make "in live" disappear on reboot. This
# tool fixes that on Ubuntu's live-boot, which we verified in
# live-boot 20230131 (9990-overlay.sh / 9990-misc-helpers.sh):
#
#   * boot param  persistence persistence-label=KIANPERSIST  (already on
#     every Kian OS boot entry — set in live/auto/config)
#   * live-boot scans for a filesystem (or file) LABELLED KIANPERSIST
#   * if found, it mounts it and reads /persistence.conf from it
#   * the line "/ union" gives FULL-ROOT overlayfs persistence: every file
#     in /home/kian, every /etc change, every apt install is stored on the
#     partition and really survives reboots
#   * if NO such store exists, live-boot falls back to a RAM overlay and
#     boots normally — that is why persistence can safely be on every entry
#
# USAGE
#   sudo kian-persist              # auto-pick the target disk (see below)
#   sudo kian-persist /dev/sdX     # erase THIS disk and use it for persistence
#   sudo kian-persist --help
#
# Auto-pick: empty unpartitioned disks first (a new VMware/QEMU virtual
# disk), then the largest disk that is NOT the boot medium. A countdown
# with a loud warning runs before anything is erased — Ctrl+C aborts.

set -uo pipefail

LABEL="KIANPERSIST"

say()  { printf '\033[1;34m[kian-persist]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[kian-persist]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[kian-persist] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

for arg in "$@"; do
    case "$arg" in
        -h|--help) usage; exit 0 ;;
    esac
done

[ "$(id -u)" -eq 0 ] || die "must run as root:  sudo kian-persist"
command -v parted >/dev/null || die "parted missing from this ISO"
command -v mkfs.ext4 >/dev/null || die "mkfs.ext4 missing from this ISO"

for arg in "$@"; do
    case "$arg" in
        -h|--help) usage; exit 0 ;;
        /dev/*) DEVICE_ARG="$arg" ;;
        *) die "unknown argument: $arg (try --help)" ;;
    esac
done

# --- already have a persistence store? --------------------------------------
if [ -e "/dev/disk/by-label/${LABEL}" ]; then
    say "a persistence store already exists: $(readlink -f /dev/disk/by-label/${LABEL})"
    say "just reboot — the 'persistence persistence-label=${LABEL}' boot param"
    say "is already on every Kian OS entry; /persistence.conf decides what to keep."
    exit 0
fi

# --- boot medium (never erase the device the ISO is running from) ------------
boot_medium_disk() {
    local src parent
    src="$(findmnt -no SOURCE /run/live/medium 2>/dev/null)" || return 0
    case "$src" in
        /dev/sr*|/dev/loop*) echo "" ;;
        *)
            parent="$(lsblk -srno PKNAME "$src" 2>/dev/null | head -n1)"
            [ -n "$parent" ] && echo "/dev/$parent"
            ;;
    esac
}

disk_is_fresh() {
    local disk="$1"
    [ "$(lsblk -rno TYPE "${disk}" | grep -vc '^disk$')" -eq 0 ] || return 1
    [ -z "$(wipefs -q "$disk" 2>/dev/null)" ] && return 0 || return 1
}

DISK="${DEVICE_ARG:-}"
if [ -z "$DISK" ]; then
    bootdisk="$(boot_medium_disk)"
    best_mb=0
    while read -r path _type size model; do
        [ "$path" = "$bootdisk" ] && continue
        mb="$(numfmt --from=iec "${size:-0}" 2>/dev/null || echo 0)"
        [ "$mb" -ge 8192 ] || continue        # persistence needs >= 8 GiB to be useful
        if disk_is_fresh "$path"; then
            if [ "$mb" -gt "$best_mb" ]; then best_mb="$mb"; DISK="$path"; DISK_SIZE="$size"; DISK_MODEL="${model:-}"; DISK_FRESH=1; fi
        elif [ -z "$FALLBACK_DISK" ]; then
            FALLBACK_DISK="$path|$size|${model:-}"
        fi
    done < <(lsblk -rno PATH,TYPE,SIZE,MODEL 2>/dev/null | awk '$2 == "disk" && $3 != "0"')
    if [ -z "$DISK" ] && [ -n "${FALLBACK_DISK:-}" ]; then
        DISK="${FALLBACK_DISK%%|*}"; rest="${FALLBACK_DISK#*|}"; DISK_SIZE="${rest%%|*}"; DISK_MODEL="${rest#*|}"
        [ "$DISK_MODEL" = "$DISK_SIZE" ] && DISK_MODEL=""
        warn "no empty disk found — falling back to $DISK (contains data!)"
    fi
    [ -n "$DISK" ] || die "no usable disk found (>= 8 GiB, not the boot medium). Attach a virtual disk, or pass one: sudo kian-persist /dev/sdX"
fi
[ -b "$DISK" ] || die "$DISK is not a block device"

MB="$(lsblk -bno SIZE "$DISK" 2>/dev/null | awk '{printf "%d", $1/1048576}')"
[ "${MB:-0}" -ge 8192 ] || die "$DISK is only ${MB:-?} MiB — persistence needs >= 8 GiB"

# --- the erase countdown ------------------------------------------------------
echo
echo "==================================================================="
echo "  EVERYTHING ON $DISK WILL BE ERASED and become the Kian OS"
echo "  persistent-session store (partition label ${LABEL})."
[ -z "${DEVICE_ARG:-}" ] && [ -z "${DISK_FRESH:-}" ] && echo "  (auto-picked: empty disks are preferred; this disk contains data)"
echo "==================================================================="
printf '\nContinuing in 8 seconds — press Ctrl+C to abort NOW, Enter to continue ... '
read -t 8 -r _ || true
echo

# --- create the partition -----------------------------------------------------
say "wiping $DISK and creating an ext4 partition labelled ${LABEL} ..."
sync
wipefs -a "$DISK" >/dev/null 2>&1 || true
parted -s "$DISK" mklabel gpt mkpart "${LABEL}" ext4 1MiB 100% || die "partitioning failed (is $DISK in use?)"
case "$DISK" in
    /dev/nvme*|/dev/mmcblk*) PART="${DISK}p1" ;;
    *) PART="${DISK}1" ;;
esac
sleep 1
mkfs.ext4 -F -L "$LABEL" "$PART" || die "mkfs.ext4 failed on $PART"
sync

# /persistence.conf on the store is what enables live-boot's custom mounts:
# "/ union" = full-root overlayfs persistence (verified in
# live-boot 9990-misc-helpers.sh get_custom_mounts).
PMNT=/mnt/kian-persist
mkdir -p "$PMNT"
mount "$PART" "$PMNT" || die "could not mount $PART to write persistence.conf"
printf '/ union\n' > "$PMNT/persistence.conf"
sync
umount "$PMNT"
rmdir "$PMNT" 2>/dev/null || true

say "persistence store created: $PART (label ${LABEL}, /persistence.conf written)"
cat <<EOF

  From the NEXT boot on — nothing else to configure:
    1. reboot (sudo reboot),
    2. everything you do in the live session is REALLY saved on $PART —
       /home/kian files, /etc changes, apt installs — because the
       'persistence persistence-label=${LABEL}' boot parameter is already
       on every Kian OS boot entry and the store now carries
       /persistence.conf with "/ union" (full-root overlay persistence),
    3. without this store the session stays a normal RAM overlay.

  Your files live on $PART. Keep backups of anything important anyway.
EOF
