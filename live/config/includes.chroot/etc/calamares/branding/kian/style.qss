/* Kian OS Calamares styling — dark navy + Kian blue. */
QStackedWidget, QGroupBox, QLabel {
    background-color: #ffffff;
    color: #1A2B4A;
}
#sidebar {
    background-color: #1A2B4A;
}
#sidebar QLabel {
    color: #ffffff;
}
QPushButton {
    background-color: #0078D4;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #1084e2;
}
