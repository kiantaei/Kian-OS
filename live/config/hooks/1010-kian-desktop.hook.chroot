#!/bin/sh
# Kian OS chroot hook — desktop + installer plumbing.
# Runs inside the live-build chroot with root privileges (noble).

set -e
echo "[kian] chroot hook: desktop + installer plumbing"

# LightDM is the display manager; make the symlink certain even if another
# DM was pulled in by a dependency.
if command -v systemctl >/dev/null 2>&1; then
    systemctl set-default graphical.target || true
    systemctl enable lightdm.service || true
fi

# Desktop polish: Kian launchers in the menu DB, icon caches, XDG dirs.
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    for dir in /usr/share/icons/*/; do
        gtk-update-icon-cache -f "$dir" >/dev/null 2>&1 || true
    done
fi

# Falkon must exist (xenox wraps it); be loud now rather than a broken
# launcher later.
command -v falkon >/dev/null || { echo "FATAL: falkon missing"; exit 1; }
command -v calamares >/dev/null || { echo "FATAL: calamares missing"; exit 1; }
command -v rsync >/dev/null || { echo "FATAL: rsync missing"; exit 1; }
command -v parted >/dev/null || { echo "FATAL: parted missing"; exit 1; }
python3 -c "import ast; ast.parse(open('/usr/local/bin/kian-welcome').read())" || { echo "FATAL: kian-welcome does not compile"; exit 1; }
bash -n /usr/local/bin/kian-install || { echo "FATAL: kian-install syntax"; exit 1; }
bash -n /usr/local/bin/kian-persist || { echo "FATAL: kian-persist syntax"; exit 1; }
bash -n /usr/local/bin/xenox || { echo "FATAL: xenox syntax"; exit 1; }
bash -n /usr/local/bin/kian-cleanup-live-only || { echo "FATAL: cleanup syntax"; exit 1; }

# The vendored automirror module needs python libcalamares + distro; the
# config files must be parseable YAML — cheap sanity check.
test -f /etc/calamares/settings.conf
test -f /etc/calamares/branding/kian/branding.desc
test -f /usr/lib/x86_64-linux-gnu/calamares/modules/automirror/main.py
python3 -c "import yaml, sys; yaml.safe_load(open('/etc/calamares/settings.conf'))" \
    || { echo "FATAL: settings.conf is not valid YAML"; exit 1; }

# arch leftovers must be gone — this is an Ubuntu-based OS now.
if command -v pacman >/dev/null 2>&1; then
    echo "FATAL: pacman found in the chroot — Arch base was not removed"
    exit 1
fi

# live-build in ubuntu mode unconditionally extracts
# /usr/share/gfxboot-theme-ubuntu/bootlogo.tar.gz during lb_binary_syslinux,
# but that package no longer exists in noble. Provide a minimal valid stub:
# an empty cpio 'bootlogo' in a tar.gz, which makes the extraction succeed
# and adds nothing to the boot menu (the live-build theme renders its own
# splash.png from splash.svg via rsvg).
GFXDIR=/usr/share/gfxboot-theme-ubuntu
if [ ! -e "$GFXDIR/bootlogo.tar.gz" ]; then
    mkdir -p "$GFXDIR"
    TMPCPIO="$(mktemp -d)"
    ( cd "$TMPCPIO" && find . -mindepth 0 -maxdepth 0 | cpio -o --format=newc > bootlogo ) >/dev/null 2>&1
    tar czf "$GFXDIR/bootlogo.tar.gz" -C "$TMPCPIO" bootlogo
    rm -rf "$TMPCPIO"
fi

# rsvg compatibility shim: live-build renders the syslinux splash with the
# OLD rsvg CLI (`rsvg --format png --height H --width W input.svg output.png`
# — output as a positional argument), but noble's librsvg2-bin ships only
# rsvg-convert, which takes the output via -o and has no `rsvg` binary.
# Translate: the last two positional arguments are input and output.
RSVG_SHIM='/usr/local/bin/rsvg'
cat > "$RSVG_SHIM" <<'RSVGEOF'
#!/bin/sh
# Kian OS shim: old rsvg CLI -> rsvg-convert (librsvg2-bin, noble).
count=$#
if [ "$count" -lt 2 ]; then
    exec /usr/bin/rsvg-convert "$@"
fi
in=""
out=""
i=1
while [ "$i" -le "$count" ]; do
    case "$i" in
        $((count - 1))) in="$1" ;;
        "$count")       out="$1" ;;
        *)              set -- "$@" "$1" ;;   # keep leading flags in order
    esac
    shift
    i=$((i + 1))
done
exec /usr/bin/rsvg-convert "$@" -o "$out" "$in"
RSVGEOF
chmod 755 "$RSVG_SHIM"
ln -sf /usr/local/bin/rsvg /usr/bin/rsvg

# Apt hygiene for the live image (live-build cleans the cache too, but be
# certain — the ISO must stay lean).
apt-get clean >/dev/null 2>&1 || true

echo "[kian] chroot hook: done"
