# Kian OS 1.0 package list (Ubuntu 24.04 noble, amd64).
# Every name was verified against the noble archive indexes
# (main/universe/restricted/multiverse) on the build date.

# ---- live system (live-boot + live-config create user `kian`, autologin,
#      timezone/locale from boot params) ----
live-boot
live-boot-initramfs-tools
live-config
live-config-systemd
sudo

# ---- firmware (explicit: live-build 3.0~a57-1ubuntu49's own firmware
# pass is broken on noble — it feeds garbage tokens to apt) ----
linux-firmware

# ---- networking ----
network-manager
network-manager-gnome
network-manager-config-connectivity-ubuntu

# ---- X11 (modesetting DDX + VMware driver) ----
xserver-xorg
xserver-xorg-video-vmware
x11-xserver-utils

# ---- XFCE desktop ----
xfce4
xfce4-terminal
xfce4-whiskermenu-plugin
xfce4-taskmanager
xfce4-power-manager
xfce4-notifyd
xfdesktop4
xfwm4
thunar
thunar-volman
tumbler
gvfs
gvfs-backends
exo-utils
mousepad
galculator
lightdm
lightdm-gtk-greeter
lightdm-gtk-greeter-settings
lxpolkit
materia-gtk-theme
papirus-icon-theme
fonts-liberation
fonts-dejavu-core
fonts-noto-core

# ---- browser (chromium/firefox are snap shims on noble — falkon is a real deb) ----
falkon

# ---- desktop plumbing / welcome GUI / automirror ----
linux-firmware

xdg-user-dirs
xdg-utils
policykit-1
python3-gi
python3-gi-cairo
gir1.2-gtk-3.0
gir1.2-glib-2.0
python3-distro

# ---- Calamares graphical installer (+ vendored automirror module needs python3-distro) ----
calamares
os-prober
python3-parted

# ---- bootloader stack (both firmwares; grub-pc preseeded non-interactive) ----
grub-efi-amd64
grub-efi-amd64-bin
grub-pc
grub-pc-bin
shim-signed
efibootmgr
initramfs-tools

# ---- preinstalled developer tools ----
git
python3
nano
vim-tiny
htop
tree
man-db
bash-completion
neofetch
curl
wget
rsync

# ---- virtualization guest agents (VMware is the primary target) ----
open-vm-tools
open-vm-tools-desktop
qemu-guest-agent

# ---- filesystem / partitioning tools for kian-install + kian-persist ----
dosfstools
e2fsprogs
parted
locales
keyboard-configuration
console-setup
