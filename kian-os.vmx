.encoding = "windows-1252"
config.version = "8"
virtualHW.version = "15"
floppy0.present = "FALSE"
usb.present = "TRUE"
ehci.present = "TRUE"
sound.present = "TRUE"
sound.virtualDev = "hdaudio"
ethernet0.present = "TRUE"
ethernet0.virtualDev = "e1000"
ethernet0.connectionType = "nat"
displayName = "Kian OS 1.0 Horizon (Ubuntu 24.04 base)"
guestOS = "other5xlinux-64"
memsize = "4096"
numvcpus = "2"
cpuid.coresPerSocket = "1"
sata0.present = "TRUE"
sata0:0.present = "TRUE"
sata0:0.fileName = "Kian OS.vmdk"
ide1:0.present = "TRUE"
ide1:0.fileName = "kian-os-1.0.0-amd64.iso"
ide1:0.deviceType = "cdrom-image"
ide1:0.startConnected = "TRUE"
bios.bootOrder = "cdrom"
boot.order = "cdrom"
# No firmware boot delay: with bootOrder=cdrom the ISO menu itself is the
# selector (1 s timeout) — waiting 3 s in the BIOS adds nothing but boot time.
bios.bootDelay = "0"
firmware = "bios"
# To boot Kian OS in UEFI mode instead (the ISO supports both), replace the
# line above with BOTH of these — Secure Boot must stay off, the Kian ISO
# ships no signed shim, and an enabled Secure Boot gives a black screen:
# firmware = "efi"
# efi.secureBoot.enabled = "FALSE"
tools.syncTime = "TRUE"
sound.autodetect = "TRUE"
ethernet0.addressType = "generated"
ethernet0.wakeOnPcktRcv = "TRUE"
usb.autoConnect.device0 = "TRUE"
usb.autoConnect.device1 = "TRUE"
usb.generic.autoconnect = "TRUE"
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "serial.log"
serial0.tryNoRxLoss = "FALSE"
serial0.yieldOnMsrRead = "TRUE"
pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"
pciBridge6.present = "TRUE"
pciBridge6.virtualDev = "pcieRootPort"
pciBridge6.functions = "8"
pciBridge7.present = "TRUE"
pciBridge7.virtualDev = "pcieRootPort"
pciBridge7.functions = "8"
vmci0.present = "TRUE"
hpet0.present = "TRUE"
vmmouse.present = "TRUE"
svga.autodetect = "TRUE"
vmware.tools.present = "FALSE"
