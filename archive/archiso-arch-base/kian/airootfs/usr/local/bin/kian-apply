#!/bin/bash
# Kian OS — apply Kian branding to an installed Arch system.
#
# WHY THIS EXISTS
#   archinstall installs stock Arch Linux from the official mirrors. It never
#   copies the Kian OS overlay that lives inside the live ISO (os-release,
#   wallpaper, xenox, Kian app launchers, panel/desktop defaults), so an
#   archinstall installation boots as plain Arch. This script copies that
#   overlay onto an installed root, making the installed system Kian OS on an
#   Arch base.
#
# USAGE
#   sudo kian-apply                 # detect the installed Arch root and ask
#   sudo kian-apply /dev/sda2       # apply to that partition
#   sudo kian-apply /mnt            # apply to an already-mounted root
#   sudo kian-apply -y /dev/sda2    # no confirmation prompt
#   sudo kian-apply --no-gui        # branding only, never install packages
#
#   Works on an archinstall target (ext4 OR the default "btrfs with
#   subvolumes" layout — the @ subvolume is mounted automatically).
#
#   If the target has no desktop (archinstall "minimal" profile), kian-apply
#   offers to install the full Kian OS desktop (Xfce + LightDM + Chromium +
#   apps) into it with pacman, so the installed system really is Kian OS and
#   not plain Arch. Pass --no-gui to skip that.
#
#   Run it from the live ISO (the branding files only exist there). It is
#   idempotent: running it twice copies the same files again.

set -uo pipefail

LIVE="${KIAN_LIVE_ROOT:-/}"   # root of the live medium (overridable for tests)
TARGET_ARG=""
ASSUME_YES=0
NO_GUI=0
T=""                          # target root once mounted
MP=""                         # mountpoint we created
MOUNTED_BY_US=0

say()  { printf '\033[1;34m[kian-apply]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[kian-apply]\033[0m %s\n' "$*" >&2; }
die()  { printf 'kian-apply: %s\n' "$*" >&2; exit 1; }

usage() {
    sed -n '3,28p' "$0" | sed 's/^# \{0,1\}//'
}

# cp + chmod in one step; avoids depending on `install`, which is not present
# in every environment this script is tested in (e.g. a Git Bash sandbox).
put() {
    local src="$1" dest="$2" mode="$3"
    mkdir -p "$(dirname "$dest")" || return 1
    cp -f "$src" "$dest" || return 1
    chmod "$mode" "$dest" 2>/dev/null || true
}

is_arch_root() {
    local dir="$1"
    [ -f "$dir/usr/bin/pacman" ] || return 1
    [ -f "$dir/etc/fstab" ] || return 1
    grep -qE '^(ID=arch|ID=kian)$' "$dir/usr/lib/os-release" 2>/dev/null || return 1
}

# Prints WHY a directory is not a usable Arch/Kian root (for the error message).
arch_check_reason() {
    local dir="$1"
    if [ -d "$dir/@/usr/bin" ] && [ ! -f "$dir/usr/bin/pacman" ]; then
        echo "this is the btrfs top level — the root lives in the @ subvolume (mount it with: mount -o subvol=@ <dev> <dir>, or just run: sudo kian-apply <dev>)"
        return
    fi
    if [ ! -f "$dir/usr/bin/pacman" ]; then
        if [ -d "$dir/EFI" ] || lsblk -rno FSTYPE "$(findmnt -no SOURCE --target "$dir" 2>/dev/null)" 2>/dev/null | grep -qx vfat; then
            echo "no /usr/bin/pacman — this looks like the EFI system partition (vfat), not the root; pass the root partition instead (lsblk -f)"
        else
            echo "no /usr/bin/pacman — not an Arch root (wrong partition?)"
        fi
        return
    fi
    if [ ! -f "$dir/etc/fstab" ]; then
        if [ -d "$dir/@/usr/bin/pacman" ]; then
            echo "mounted the btrfs top level — the root lives in the @ subvolume (remounting was not possible; mount it with: mount -o subvol=@ <dev> <dir>)"
        else
            echo "no /etc/fstab in this root — not a finished install?"
        fi
        return
    fi
    grep -qE '^(ID=arch|ID=kian)$' "$dir/usr/lib/os-release" 2>/dev/null \
        || echo "no ID=arch / ID=kian in /usr/lib/os-release"
}

mount_root() {   # $1 = device
    local dev="$1" fstype=""
    [ -n "$MP" ] || MP="$(mktemp -d /run/kian-apply.XXXXXX 2>/dev/null || mktemp -d)"
    fstype="$(lsblk -rno FSTYPE "$dev" 2>/dev/null | head -n1)"
    # btrfs layouts installed with an @ subvolume (archinstall's DEFAULT
    # "btrfs with subvolumes" choice) cannot be used through the top level:
    # a plain mount succeeds (subvolid=5) but shows no /etc, so for btrfs the
    # @ subvolume must be tried FIRST, not only as a fallback.
    if [ "$fstype" = "btrfs" ]; then
        local sub
        for sub in @ @archlinux-linux rootfs root; do
            if mount -t btrfs -o "subvol=$sub" "$dev" "$MP" 2>/dev/null; then
                MOUNTED_BY_US=1
                return 0
            fi
        done
    fi
    if mount "$dev" "$MP" 2>/dev/null; then
        MOUNTED_BY_US=1
        # A btrfs filesystem without subvolumes mounts fine this way; one WITH
        # an @ root that we could not mount directly is detected here.
        if [ "$fstype" = "btrfs" ] && [ ! -e "$MP/etc/fstab" ] && [ -e "$MP/@/usr/bin/pacman" ]; then
            umount "$MP" 2>/dev/null || true
            MOUNTED_BY_US=0
            mount -t btrfs -o subvol=@ "$dev" "$MP" 2>/dev/null || return 1
            MOUNTED_BY_US=1
        fi
        return 0
    fi
    return 1
}

unmount_root() {
    [ "$MOUNTED_BY_US" -eq 1 ] || return 0
    sync
    umount "$MP" 2>/dev/null || warn "could not unmount $MP"
    rmdir "$MP" 2>/dev/null || true
    MOUNTED_BY_US=0
}
trap unmount_root EXIT

# --- candidate detection ----------------------------------------------------
# Prints one line per filesystem that looks like an Arch install:
#   <device>\t<mount option>
detect_candidates() {
    command -v lsblk >/dev/null || return 0
    lsblk -rno PATH,FSTYPE 2>/dev/null | while read -r dev fstype; do
        case "$fstype" in
            ext2|ext3|ext4|btrfs|xfs|f2fs) ;;
            crypto_LUKS)
                warn "$dev is encrypted (LUKS) — unlock it first, then mount it and run: sudo kian-apply /mnt"
                continue
                ;;
            *) continue ;;
        esac
        if command -v findmnt >/dev/null && findmnt -n --source "$dev" >/dev/null 2>&1; then
            continue
        fi
        local probe
        probe="$(mktemp -d /run/kian-probe.XXXXXX 2>/dev/null || mktemp -d)"
        if mount -o ro "$dev" "$probe" 2>/dev/null; then
            if is_arch_root "$probe"; then
                printf '%s\t\n' "$dev"
            elif [ -f "$probe/@/usr/bin/pacman" ] && [ -f "$probe/@/etc/fstab" ]; then
                printf '%s\t-o subvol=@\n' "$dev"
            fi
            umount "$probe" 2>/dev/null
        fi
        rmdir "$probe" 2>/dev/null || true
    done
}

# --- desktop installation ---------------------------------------------------
# The Kian desktop package set, mirrored from archiso/kian/packages.x86_64
# (desktop + applications + fonts + VM guest agents). Installing it into an
# archinstall "minimal" target is what turns plain Arch into Kian OS.
KIAN_DESKTOP_PKGS=(
    xorg-server xf86-input-libinput xf86-input-vmmouse xf86-video-vesa
    lightdm lightdm-gtk-greeter
    exo garcon thunar thunar-volman tumbler gvfs
    xfce4-appfinder xfce4-panel xfce4-power-manager xfce4-session
    xfce4-settings xfce4-terminal xfconf xfdesktop xfwm4
    xfce4-whiskermenu-plugin xfce4-taskmanager
    xdg-user-dirs xdg-utils polkit-gnome
    materia-gtk-theme papirus-icon-theme ttf-liberation ttf-dejavu noto-fonts
    chromium mousepad galculator
    networkmanager network-manager-applet
    git python nano bash-completion htop tree man-db fastfetch
    open-vm-tools qemu-guest-agent
)

install_desktop() {   # $1 = target root
    local t="$1"
    [ -f "$t/etc/pacman.conf" ] || {
        warn "target has no /etc/pacman.conf — cannot install the desktop; install Xfce manually";
        return 1;
    }
    if ! ping -c1 -W3 archlinux.org >/dev/null 2>&1; then
        warn "no network — cannot install the desktop now. Connect and re-run: sudo kian-apply $t"
        return 1
    fi

    say "installing the Kian OS desktop into the target (${#KIAN_DESKTOP_PKGS[@]} packages, this downloads a few hundred MB)"

    # pacman must run against the target with the target's repos/keyring.
    # arch-chroot (from arch-install-scripts, shipped with archinstall) is the
    # battle-tested path; --sysroot (newer pacman) is the fallback.
    if command -v arch-chroot >/dev/null 2>&1; then
        RUN_IN_TARGET() { arch-chroot "$t" "$@"; }
        # the fresh target may have no resolv.conf yet — without DNS pacman
        # cannot reach the mirrors (a dangling systemd-resolved symlink counts
        # as missing here).
        if [ -L "$t/etc/resolv.conf" ] || [ ! -s "$t/etc/resolv.conf" ]; then
            rm -f "$t/etc/resolv.conf"
            cp /etc/resolv.conf "$t/etc/resolv.conf" 2>/dev/null || warn "could not seed /etc/resolv.conf in the target"
        fi
    elif pacman --help 2>/dev/null | grep -q -- '--sysroot'; then
        RUN_IN_TARGET() { pacman --sysroot "$t" "$@"; }
    else
        warn "neither arch-chroot nor pacman --sysroot is available — cannot install the desktop"
        return 1
    fi

    say "syncing the target package database ..."
    if ! RUN_IN_TARGET pacman -Sy >/tmp/kian-desktop-install.log 2>&1; then
        warn "could not sync pacman databases in the target (mirrorlist/keyring issue?)"
        tail -n 10 /tmp/kian-desktop-install.log >&2 || true
        warn "try manually: arch-chroot $t pacman -Syu, then re-run: sudo kian-apply $t"
        return 1
    fi
    if ! RUN_IN_TARGET pacman -S --needed --noconfirm "${KIAN_DESKTOP_PKGS[@]}" >>/tmp/kian-desktop-install.log 2>&1; then
        warn "desktop installation failed — the log is at /tmp/kian-desktop-install.log"
        tail -n 20 /tmp/kian-desktop-install.log >&2 || true
        return 1
    fi
    say "desktop installed"

    # Login manager + network: a Kian OS install boots to a graphical greeter
    # (the live ISO's autologin must NOT be copied to an installed system).
    systemctl --root "$t" enable lightdm.service NetworkManager.service >/dev/null 2>&1 \
        && say "enabled lightdm (graphical login) and NetworkManager in the target"
    systemctl --root "$t" enable vmtoolsd.service >/dev/null 2>&1 || true
    return 0
}

# --- the actual branding copy ----------------------------------------------
apply_branding() {
    local t="$1"
    if ! is_arch_root "$t"; then
        die "$t does not look like an Arch/Kian install ($(arch_check_reason "$t"))"
    fi

    [ -f "$LIVE/usr/share/kian/os-release" ] || die "branding source not found at $LIVE/usr/share/kian — run this from the Kian OS live ISO"

    # A target without a desktop (archinstall "minimal" profile) would end up
    # as branded-but-graphless Arch. Offer the real Kian desktop instead.
    local gui_installed=0
    if [ ! -x "$t/usr/bin/xfce4-session" ] && [ "$NO_GUI" -ne 1 ]; then
        local reply="n"
        if [ "$ASSUME_YES" -eq 1 ]; then
            reply="y"
        else
            printf 'This target has no desktop. Install the Kian OS desktop (Xfce + Chromium, ~1 GB from the repos)? [Y/n] '
            read -r reply
            case "$reply" in n|N|no|NO) reply="n" ;; *) reply="y" ;; esac
        fi
        if [ "$reply" = "y" ]; then
            install_desktop "$t" && gui_installed=1
        else
            say "skipping desktop installation (--no-gui or declined)"
        fi
    fi

    say "installing Kian OS identity into $t"
    put "$LIVE/usr/share/kian/os-release" "$t/usr/lib/os-release" 0644
    # /etc/os-release is normally a symlink to ../usr/lib/os-release; if the
    # install replaced it with a real file, overwrite that too.
    if [ -f "$t/etc/os-release" ] && [ ! -L "$t/etc/os-release" ]; then
        put "$LIVE/usr/share/kian/os-release" "$t/etc/os-release" 0644
    fi
    put "$LIVE/etc/motd" "$t/etc/motd" 0644

    mkdir -p "$t/usr/share/kian" "$t/usr/share/backgrounds/kian"
    cp -a "$LIVE/usr/share/kian/." "$t/usr/share/kian/" || warn "copying /usr/share/kian failed"
    cp -a "$LIVE/usr/share/backgrounds/kian/." "$t/usr/share/backgrounds/kian/" || warn "copying the wallpaper failed"

    say "installing Kian applications and desktop entries"
    mkdir -p "$t/usr/share/applications"
    cp -a "$LIVE"/usr/share/applications/kian-*.desktop "$t/usr/share/applications/" 2>/dev/null || true
    put "$LIVE/usr/bin/xenox" "$t/usr/bin/xenox" 0755
    put "$LIVE/usr/bin/neofetch" "$t/usr/bin/neofetch" 0755
    put "$LIVE/usr/local/bin/kian-panel-position-fix" "$t/usr/local/bin/kian-panel-position-fix" 0755
    put "$LIVE/usr/local/bin/kian-trust-desktop" "$t/usr/local/bin/kian-trust-desktop" 0755
    mkdir -p "$t/etc/xdg/autostart"
    cp -a "$LIVE"/etc/xdg/autostart/kian-*.desktop "$t/etc/xdg/autostart/" 2>/dev/null || true

    say "installing Kian defaults (skel, graphics, identity hook)"
    mkdir -p "$t/etc/skel"
    cp -a "$LIVE/etc/skel/." "$t/etc/skel/" || warn "copying /etc/skel failed"
    put "$LIVE/etc/X11/xorg.conf.d/20-kian-graphics.conf" "$t/etc/X11/xorg.conf.d/20-kian-graphics.conf" 0644
    # Greeter branding only: the live ISO's lightdm.conf auto-logs-in as `kian`,
    # which an installed system must not do, so it is deliberately not copied.
    if [ -d "$t/etc/lightdm" ] && [ -f "$LIVE/etc/lightdm/lightdm-gtk-greeter.conf" ]; then
        put "$LIVE/etc/lightdm/lightdm-gtk-greeter.conf" "$t/etc/lightdm/lightdm-gtk-greeter.conf" 0644
    fi
    # Keep the Kian identity across future `filesystem` upgrades in the target.
    put "$LIVE/etc/pacman.d/hooks/kian-os-release.hook" "$t/etc/pacman.d/hooks/kian-os-release.hook" 0644

    # Existing users: add whatever Kian defaults they are missing (never
    # overwrite their own files) and make the launchers executable.
    local home user uid gid f
    for home in "$t"/home/*; do
        [ -d "$home" ] || continue
        user="$(basename "$home")"
        uid="$(awk -F: -v u="$user" '$1==u{print $3}' "$t/etc/passwd" 2>/dev/null)"
        gid="$(awk -F: -v u="$user" '$1==u{print $4}' "$t/etc/passwd" 2>/dev/null)"
        [ -n "${uid:-}" ] || continue
        cp -a -n "$t/etc/skel/." "$home/" 2>/dev/null || true
        chmod 755 "$home"/Desktop/*.desktop 2>/dev/null || true
        chown -R "$uid:$gid" "$home" 2>/dev/null || warn "could not chown $home to $user"
        say "seeded Kian defaults for user $user"
    done

    # Boot menu branding (GRUB shows GRUB_DISTRIBUTOR).
    if [ -f "$t/etc/default/grub" ] && grep -q '^GRUB_DISTRIBUTOR=' "$t/etc/default/grub"; then
        sed -i 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR="Kian OS"|' "$t/etc/default/grub"
        if [ -f "$t/boot/grub/grub.cfg" ] && [ -x "$t/usr/bin/grub-mkconfig" ] && command -v arch-chroot >/dev/null; then
            say "regenerating the GRUB menu"
            if arch-chroot "$t" grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1; then
                say "GRUB menu updated"
            else
                warn "could not regenerate GRUB; run this in the installed system: sudo grub-mkconfig -o /boot/grub/grub.cfg"
            fi
        fi
    fi

    # Things we cannot fix by copying files (only reached when the desktop
    # was declined with --no-gui, or its installation failed).
    if [ ! -x "$t/usr/bin/xfce4-session" ]; then
        warn "the target still has no desktop — Kian files are installed, but there is nothing to show them yet."
        warn "install it later (connected): sudo kian-apply $t   (or: arch-chroot $t pacman -S xorg-server lightdm lightdm-gtk-greeter xfce4 chromium)"
    fi

    # XFCE stores the wallpaper per user; the skel config points at the Kian
    # wallpaper, but a user created by archinstall already has an xfconf file.
    if [ -d "$t/home" ]; then
        for home in "$t"/home/*; do
            f="$home/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml"
            [ -f "$f" ] || continue
            if grep -q 'last-image' "$f"; then
                # Only the image properties: image-style is an int in the same
                # file and must not be replaced with a path.
                sed -i '/last-image/ s|value="[^"]*"|value="/usr/share/backgrounds/kian/kian-wallpaper.jpg"|' "$f"
                user="$(basename "$home")"
                uid="$(awk -F: -v u="$user" '$1==u{print $3}' "$t/etc/passwd" 2>/dev/null)"
                gid="$(awk -F: -v u="$user" '$1==u{print $4}' "$t/etc/passwd" 2>/dev/null)"
                [ -n "${uid:-}" ] && chown "$uid:$gid" "$f" 2>/dev/null || true
            fi
        done
    fi

    say "done — Kian OS branding applied to $t"
}

# --- main -------------------------------------------------------------------
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -y|--yes)  ASSUME_YES=1 ;;
        --auto)    ASSUME_YES=1 ;;   # kept for compatibility
        --no-gui)  NO_GUI=1 ;;
        -*)        die "unknown option: $1" ;;
        *)         TARGET_ARG="$1" ;;
    esac
    shift
done

if [ "$(id -u)" -ne 0 ]; then
    die "must run as root:  sudo kian-apply${TARGET_ARG:+ $TARGET_ARG}"
fi

if [ -n "$TARGET_ARG" ]; then
    if [ -d "$TARGET_ARG" ]; then
        T="$TARGET_ARG"          # already mounted by the caller
    elif [ -b "$TARGET_ARG" ]; then
        if [ "$(lsblk -rno TYPE "$TARGET_ARG" 2>/dev/null)" = "disk" ]; then
            die "$TARGET_ARG is a whole disk — pass its ROOT PARTITION instead (lsblk -f, usually the largest non-vfat one, e.g. /dev/sda2)"
        fi
        mount_root "$TARGET_ARG" || die "could not mount $TARGET_ARG"
        T="$MP"
    else
        die "$TARGET_ARG is neither a directory nor a block device"
    fi
else
    say "looking for an installed Arch/Kian system ..."
    candidates="$(detect_candidates)"
    count="$(printf '%s\n' "$candidates" | grep -c . || true)"
    if [ "$count" -eq 0 ]; then
        cat <<'EOF'
No installed Arch system was found.
  - If the install is on LUKS, unlock it and mount the root, then:
        sudo kian-apply /mnt
  - Otherwise pass the root partition explicitly:
        lsblk -f
        sudo kian-apply /dev/sdXN
EOF
        exit 1
    fi
    if [ "$count" -gt 1 ]; then
        warn "several Arch installations found:"
        printf '%s\n' "$candidates" | sed 's/^/  /'
        die "pass the one you want: sudo kian-apply /dev/sdXN"
    fi
    dev="$(printf '%s\n' "$candidates" | cut -f1)"
    opts="$(printf '%s\n' "$candidates" | cut -f2)"
    if [ "$ASSUME_YES" -ne 1 ]; then
        printf 'Apply Kian OS branding to %s? [y/N] ' "$dev"
        read -r reply
        case "$reply" in
            y|Y|yes|YES) ;;
            *) echo "aborted"; exit 1 ;;
        esac
    fi
    if [ "${opts:-}" = "-o subvol=@" ]; then
        MP="$(mktemp -d /run/kian-apply.XXXXXX 2>/dev/null || mktemp -d)"
        mount -t btrfs -o subvol=@ "$dev" "$MP" || die "could not mount $dev (subvol=@)"
        MOUNTED_BY_US=1
        T="$MP"
    else
        mount_root "$dev" || die "could not mount $dev"
        T="$MP"
    fi
fi

apply_branding "$T"

if [ "$MOUNTED_BY_US" -eq 1 ]; then
    say "unmounting $T"
fi
